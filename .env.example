# App
APP_ENV=dev
APP_HOST=127.0.0.1
APP_PORT=8000
DATABASE_URL=sqlite+aiosqlite:///./data/jobcrm.db
# Comma-separated browser origins. Prod: https://your.domain (nginx same-origin
# does not need CORS; this is for the Next dev server and any extra UI hosts).
ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
APP_ROLE=all
# Empty in dev (tokens stored plaintext). Compose gen-secrets.sh fills this.
TOKEN_FERNET_KEY=

# LLM: openai | ollama
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Scraper politeness
SCRAPER_MIN_DELAY_SEC=1.5
SCRAPER_MAX_DELAY_SEC=4.0
SCRAPER_MAX_PAGES=40
# Simultaneous crawls. hh+GetMatch share one Chrome under this.
SCRAPER_GLOBAL_CONCURRENCY=3
SCRAPER_BROWSER_CONCURRENCY=1
SCRAPER_HIREHI_CONCURRENCY=2
SCRAPER_HABR_CONCURRENCY=2
SCRAPER_GEEKJOB_CONCURRENCY=2
SCRAPER_CAREER_CONCURRENCY=3

# Google OAuth — вход и календарь. Один Web client.
# Authorized redirect URIs must include the origin you actually open:
#   https://127.0.0.1:8443/api/google/callback
#   http://localhost:3000/api/google/callback
# Scopes: openid, email, profile, calendar.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://127.0.0.1:8443/api/google/callback
GOOGLE_CALENDAR_TIMEZONE=Europe/Moscow

# Telegram: host Telethon scrape (channels) vs per-user bot (digests).
# TELEGRAM_API_ID=
# TELEGRAM_API_HASH=
# Bot from @BotFather. One Hunt account ↔ one Telegram user.
TELEGRAM_BOT_TOKEN=

# Optional: extra Telegram chat for bug/idea pings. Host bind in Settings →
# Уведомления is enough without this.
# FEEDBACK_TELEGRAM_CHAT_ID=

# Optional SMTP. Gmail app password is free (smtp.gmail.com:587).
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=
# SMTP_FROM=you@gmail.com
# FEEDBACK_EMAIL_TO=you@gmail.com
