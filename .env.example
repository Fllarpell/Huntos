# App
APP_ENV=dev
APP_HOST=127.0.0.1
APP_PORT=8000
DATABASE_URL=sqlite+aiosqlite:///./data/jobcrm.db
# Comma-separated browser origins. Prod: https://your.domain (nginx same-origin
# does not need CORS; this is for the Next dev server and any extra UI hosts).
ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
APP_ROLE=all
# Empty in dev (tokens stored plaintext). Compose gen-secrets.sh fills this.
TOKEN_FERNET_KEY=

# LLM: openai | ollama
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Scraper politeness
SCRAPER_MIN_DELAY_SEC=1.5
SCRAPER_MAX_DELAY_SEC=4.0
SCRAPER_MAX_PAGES=10

# Google Calendar OAuth (optional — can also paste Client ID/Secret in Settings)
# Create a Web client. Authorized redirect URI must be exactly:
# http://localhost:3000/api/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback
GOOGLE_CALENDAR_TIMEZONE=Europe/Moscow
