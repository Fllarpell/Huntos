# Copy to bootstrap.env (mode 600) on the target host. Never commit bootstrap.env.
#   cp bootstrap.env.example /root/bootstrap.env && chmod 600 /root/bootstrap.env

# Linux account that owns Ed25519 auth. Root SSH is disabled in stage 1 already.
ADMIN_USER=deploy

# Full authorized_keys line. Ed25519 only — RSA/ECDSA are rejected by sshd drop-in.
ADMIN_SSH_PUBKEY="ssh-ed25519 AAAA... comment"

# Optional extra keys, one per line, same algorithm constraint.
# ADMIN_SSH_PUBKEY_EXTRA="ssh-ed25519 AAAA... laptop"

# Public NIC. Leave empty to take the default-route interface.
PUBLIC_IFACE=

# WireGuard
WG_IFACE=wg0
WG_ADDRESS=10.7.0.1/24
WG_PORT=51820
# Client public key (wg pubkey < client.key). Required — we do not generate client keys on the server.
WG_CLIENT_PUBKEY=
WG_CLIENT_ADDRESS=10.7.0.2/32

# SSH
SSH_PORT=22
SSH_LOCKDOWN_PORT=2222

# 1 = after a live WG handshake, bind sshd to WG only and drop public :22
LOCKDOWN=0

# CrowdSec community blocklists. 0 if the host has no outbound to crowdsec.net yet.
ENABLE_CROWDSEC=1

# Install Docker CE from docker.com (not distro docker.io).
ENABLE_DOCKER=1
